#!/usr/bin/env bash

# Container builds use /opt/emsdk; native builds may provide emcc on PATH.
if [ -r "${EMSDK:-/opt/emsdk}/emsdk_env.sh" ]; then
    EMSDK_QUIET=1 . "${EMSDK:-/opt/emsdk}/emsdk_env.sh"
fi

_SCRIPT_DIR=$(dirname $0);
pushd $_SCRIPT_DIR;

. ./_build_env

set -ex;

setup;
build;
copy_artifacts "../frontend/resources/public/js";
copy_shared_artifact;

exit $?;

popd
